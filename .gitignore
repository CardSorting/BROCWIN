/.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example
*.pem
*.key
*.pfx
*.p12
.git-credentials
credentials*.json

# Original/recovered game content, native state, evidence and third-party installs.
/recovered/
/recovery/
/runtime/
/reports/
/checkpoints/
/tools/
/asset-catalog.json
/browser/generated/
/browser/reference/
/browser/patches/
/wiki/generated/
/wiki/frozen-sources/

# Native/platform binaries and archive payloads are not part of the source release.
*.exe
*.dll
*.sys
*.pdb
*.kom
*.wasm
*.rar
*.7z
*.zip
